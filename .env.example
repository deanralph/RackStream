# Optional path to a system or standalone OpenSCAD executable.
# OPENSCAD_BIN=/usr/bin/openscad
# Optional local temporary-files directory, writable by the server user.
# TMPDIR=/home/your-user/.cache/rackstream
# For `python app.py` only; waitress uses its explicit --listen option.
RACKSTREAM_HOST=127.0.0.1
RACKSTREAM_PORT=8324
